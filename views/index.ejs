<h1>Welcome to CSE Motors!</h1>

<%- messages() %>

<div class="hero-image">
    <div class="hero-text">
        <h2>DMC Delorean</h2>
        <div class="features">
            <p>3 Cup holders</p>
            <p>Superman doors</p>
            <p>Fuzzy dice!</p>
        </div>

        <button class="image-button" onclick="goToPage()">
            <img src="../images/site/own_today.png" alt="Own Today button">
        </button>
    </div>
</div>

<div class="delorean-sections">
    <section class="dmc-delorean-reviews">
        <h3>DMC Delorean Reviews</h3>
        <ul>
            <li>"So fast it's almost like traveling in time." (4/5)</li>
            <li>"Coolest ride on the road." (4/5)</li>
            <li>"I'm feeling McFly!" (5/5)</li>
            <li>"The most futuristic ride of our day." (4.5/5)</li>
            <li>"80's livin and I love it!" (5/5)</li>
        </ul>
    </section>

    <section class="delorean-upgrades">
        <h3>Delorean Upgrades</h3>
        <div class="upgrades-list">
            <div class="upgrade-item">
            <a href="flux-capacitor.html">
                <img src="../images/upgrades/flux-cap.png" alt="Flux Capacitor">
                <p>Flux Capacitor</p>
            </a>
            </div>

            <div class="upgrade-item">
            <a href="flame-decals.html">
                <img src="../images/upgrades/flame.jpg" alt="Flame Decals">
                <p>Flame Decals</p>
            </a>
            </div>
            
            <div class="upgrade-item">
            <a href="bumper-stickers.html">
                <img src="../images/upgrades/bumper_sticker.jpg" alt="Bumper Stickers">
                <p>Bumper Stickers</p>
            </a>
            </div>
            
            <div class="upgrade-item">
            <a href="hub-caps.html">
                <img src="../images/upgrades/hub-cap.jpg" alt="Hub Caps">
                <p>Hub Caps</p>
            </a>
            </div>
        </div>
    </section>
</div>