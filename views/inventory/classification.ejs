<div class="classification-container">

  <% if (title) { %>
    <h1 class="classification-title"><%= title %></h1>
  <% } %>

  <!-- Messages -->
  <div class="classification-messages">
    <% if (messages && messages.length) { %>
      <ul>
        <% messages.forEach(msg => { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <!-- Vehicle grid -->
  <div class="classification-grid">
    <%- grid %>
  </div>

</div>
