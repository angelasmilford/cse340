<main class="management-container">

  <!-- Page Title -->
  <h1 class="page-title"><%= title %></h1>

  <!-- Flash Messages -->
  <% if (messages && messages.length) { %>
    <div class="flash-message">
      <ul>
        <% messages.forEach(msg => { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Action Navigation -->
  <nav class="management-nav">
    <ul>
      <li><a href="/inv/add-classification" class="nav-btn">➕ Add New Classification</a></li>
      <li><a href="/inv/add-inventory" class="nav-btn">📦 Add New Inventory Item</a></li>
    </ul>
  </nav>

  <!-- Inventory Management Section -->
  <section class="inventory-section card-section">
    <h2>Manage Inventory</h2>
    <p>Select a vehicle classification below to view and manage its inventory items.</p>

    <!-- Classification select list -->
    <form id="classificationForm" class="classification-form">
      <%- classificationSelect %>
    </form>

    <!-- Inventory display table -->
    <table id="inventoryDisplay" class="inventory-table"></table>

    <noscript class="noscript-warning">
      JavaScript must be enabled to use this page.
    </noscript>
  </section>

  <!-- JS -->
  <script src="/js/inventory.js"></script>
</main>
