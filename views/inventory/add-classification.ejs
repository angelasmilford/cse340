<main class="add-classification-container">
  <h1>Add New Classification</h1>

  <!-- Flash Messages -->
  <% if (messages && messages.length) { %>
    <div class="flash-message">
      <ul>
        <% messages.forEach(msg => { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Server-side Validation Errors -->
  <% if (errors && errors.length) { %>
    <div class="error-messages">
      <ul>
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/inv/add-classification" method="POST" novalidate>
    <label for="classification_name">Classification Name</label>
    <input 
      type="text" 
      id="classification_name" 
      name="classification_name" 
      value="<%= classification_name || '' %>" 
      required 
      pattern="^[A-Za-z0-9]+$" 
      title="Name cannot contain spaces or special characters"
    >
    <small>Classification name cannot contain spaces or special characters.</small>

    <button type="submit">Add Classification</button>
  </form>
</main>
