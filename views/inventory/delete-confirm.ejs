<main>
  <div class="delete-vehicle-container">
    <h1><%= title %></h1>

    <% if (messages && messages.length) { %>
      <div class="flash-message">
        <% messages.forEach(msg => { %>
          <p><%= msg %></p>
        <% }) %>
      </div>
    <% } %>

    <p>
      Are you sure you want to delete <%= inv_make %> <%= inv_model %> from the inventory database?
      This action <strong>cannot</strong> be undone.
    </p>

    <div class="vehicle-details">
      <strong>Vehicle:</strong><br>
      <%= inv_year %> <%= inv_make %> <%= inv_model %><br>
      <strong>Color:</strong> <%= inv_color %><br>
      <strong>Price:</strong> $<%= inv_price.toLocaleString() %>
    </div>

    <form action="/inv/delete/<%= inv_id %>" method="POST" id="deleteForm">
      <input type="hidden" name="inv_id" value="<%= inv_id %>"> 
      <input type="hidden" name="inv_make" value="<%= inv_make %>"> 
      <input type="hidden" name="inv_model" value="<%= inv_model %>"> 
      <input type="hidden" name="inv_year" value="<%= inv_year %>"> 
      <input type="hidden" name="inv_price" value="<%= inv_price %>"> 
      <input type="hidden" name="classification_id" value="<%= classification_id %>">
      
      <div class="btn-row">
        <a href="/inv" class="btn btn-cancel">Cancel</a>
        <button type="submit" class="btn btn-delete">Delete Vehicle</button>
      </div>
    </form>
  </div>
</main>
