<div class="login-container">
  <h1><%= title %></h1>

  <!-- Flash Messages -->
  <% if (messages && messages.length > 0) { %>
    <div class="flash-message"><%= messages %></div>
  <% } %>

  <!-- Server-Side Validation Errors -->
  <% if (errors) { %>
    <ul class="notice">
      <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <!-- Login Form -->
  <form id="loginForm" action="/account/login" method="post">
    <div class="form-group">
      <label for="account_email">Email:</label>
      <input type="email" name="account_email" id="accountEmail" required value="<%= locals.account_email %>">
    </div>

    <div class="form-group">
      <label for="account_password">Password:</label>
      <input type="password" name="account_password" id="accountPassword" required>
    </div>

    <button type="submit">Login</button>
  </form>

  <p class="register-link">Don't have an account? <a href="/account/register">Register here</a></p>
</div>