<div class="login-container">
  <h1><%= title %></h1>

  <!-- Flash Message -->
  <% if (messages && messages.length > 0) { %>
    <div class="flash-message"><%= messages %></div>
  <% } %>

  <!-- Login Form -->
  <form id="loginForm" action="/account/login" method="post">
    <div class="form-group">
      <label for="account_email">Email:</label>
      <input type="email" name="account_email" id="accountEmail" required value="<%= locals.account_email %>">
    </div>

    <div class="form-group">
      <label for="account_password">Password:</label>
      <span class="password-hint">
        Passwords must be at least 12 characters, include 1 capital letter, 1 number, and 1 special character.
      </span>
      <input type="password" id="account_password" name="account_password" required
             pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
             placeholder="Enter your password">
      <button type="button" onclick="togglePassword()">Show/Hide</button>
    </div>

    <button type="submit">Login</button>
  </form>

  <p class="register-link">Don't have an account? <a href="/account/register">Register here</a></p>
</div>