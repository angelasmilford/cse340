
<div class="login-container">
  <h1><%= title %></h1>

  <!-- Flash Message -->
  <% if (messages && messages.length > 0) { %>
    <div class="flash-message"><%= messages %></div>
  <% } %>

  <!-- Login Form -->
  <form action="/account/login" method="post" class="login-form">
    <div class="form-group">
      <label for="account_email">Email:</label>
      <input type="email" id="account_email" name="account_email" required>
    </div>

    <div class="form-group">
      <label for="account_password">Password:</label>
      <input type="password" id="account_password" name="account_password" required>
    </div>

    <button type="submit">Login</button>
  </form>

  <!-- Registration Link -->
  <p class="register-link">
    Don't have an account? <a href="/account/register">Register here</a>
  </p>
</div>

