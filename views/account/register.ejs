<maidivn class="register-container">
  <!-- Page Title -->
  <h1><%= title %></h1>

  <!-- Flash Messages -->
  <% if (messages && messages.length > 0) { %>
    <div class="flash-message"><%= messages %></div>
  <% } %>

  <!-- Registration Form -->
  <form action="/account/register" method="post" class="registration-form">
    <div class="form-group">
      <label for="account_firstname">First Name:</label>
      <input type="text" id="account_firstname" name="account_firstname" required>
    </div>

    <div class="form-group">
      <label for="account_lastname">Last Name:</label>
      <input type="text" id="account_lastname" name="account_lastname" required>
    </div>

    <div class="form-group">
      <label for="account_email">Email Address:</label>
      <input type="email" id="account_email" name="account_email" required>
    </div>

    <div class="form-group">
      <label for="account_password">Password:</label>
      <input type="password" id="account_password" name="account_password" required>
      <small>Password must be at least 12 characters, include 1 capital letter, 1 number, and 1 special character.</small>
      <button type="button" onclick="togglePassword()">Show/Hide</button>
    </div>

    <button type="submit">Register</button>
  </form>
</div>
