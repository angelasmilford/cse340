<main class="account-management-container">
  <title><%= title %></title>

  <div class="account-header">
    <!-- Greeting -->
    <h2>Welcome <%= accountData.account_firstname %></h2>

    <!-- Update Account Information -->
    <p>
      <a href="/account/update/<%= accountData.account_id %>">
        Update Account Information
      </a>
    </p>

    <!-- Logged in message -->
    <p class="status-text">You're logged in.</p>

    <!-- Employee/Admin Inventory Tools -->
    <% if (accountData.account_type === "Employee" || accountData.account_type === "Admin") { %>
      <h3>Inventory Management</h3>
      <p>
        <a href="/inv/">Go to Inventory Management</a>
      </p>
    <% } %>
  </div>

  <h2>Your Review History</h2>

  <% if (userReviews.length === 0) { %>
    <p>You haven't written any reviews yet.</p>
  <% } else { %>
    <ul class="review-history">
      <% userReviews.forEach(review => { %>
        <li class="review-card">
          <strong class="review-author">
            <%= review.inv_make %> <%= review.inv_model %>
          </strong>

          <p class="review-text"><%= review.review_text %></p>

          <small class="review-date">
            Posted on: <%= new Date(review.review_date).toLocaleDateString() %>
          </small>

          <form method="POST" action="/reviews/delete" class="review-delete-form">
            <input type="hidden" name="review_id" value="<%= review.review_id %>">
            <button class="delete-btn">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>

</main>