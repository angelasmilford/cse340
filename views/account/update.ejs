<main class="update-account-container">

  <!-- Page Title -->
  <h1><%= title %></h1>

  <!-- Display Flash Messages -->
  <% if (messages && messages.length > 0) { %>
    <div class="notice">
      <% messages.forEach(msg => { %>
        <p><%= msg %></p>
      <% }) %>
    </div>
  <% } %>

  <!-- Display Server-Side Validation Errors -->
  <% if (errors && errors.length > 0) { %>
    <div class="errors">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Account Update -->
  <section>
    <h2>Account Update</h2>

    <form action="/account/update" method="post" class="account-form">

      <!-- First Name -->
      <label for="account_firstname">First Name</label>
      <input
        type="text"
        id="account_firstname"
        name="account_firstname"
        value="<%= accountData.account_firstname %>"
        required
      >

      <!-- Last Name -->
      <label for="account_lastname">Last Name</label>
      <input
        type="text"
        id="account_lastname"
        name="account_lastname"
        value="<%= accountData.account_lastname %>"
        required
      >

      <!-- Email -->
      <label for="account_email">Email</label>
      <input
        type="email"
        id="account_email"
        name="account_email"
        value="<%= accountData.account_email %>"
        required
      >

      <!-- Hidden account_id -->
      <input type="hidden" name="account_id" value="<%= accountData.account_id %>">

      <button type="submit">Update Account Info</button>
    </form>
  </section>

  <!-- Change Password -->
  <section>
    <h2>Change Password</h2>

    <p class="password-info">
      Entering a new password will replace your existing password.
      Your password must meet the following requirements:
      <br>• Minimum 12 characters
      <br>• Must include lowercase, uppercase, number, and symbol
    </p>

    <form action="/account/update-password" method="post" class="password-form">

      <!-- New Password Field -->
      <label for="account_password">New Password</label>
      <input
        type="password"
        id="account_password"
        name="account_password"
        required
        minlength="12"
        pattern="(?=.*\\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#$%^&*]).{12,}"
        title="Must be at least 12 characters and include uppercase, lowercase, number, and special character."
      >

      <!-- Hidden account_id -->
      <input type="hidden" name="account_id" value="<%= accountData.account_id %>">

      <button type="submit">Change Password</button>
    </form>
  </section>

</main>

