<header id="top-header">
    <span class="siteName">
        <a href="/" title="Return to home page">CSE Motors</a>
    </span>

    <div id="tools">
        <% if (locals.loggedin) { %>
            <!-- Welcome link to account management -->
            <a href="/account/" title="Account Management">
                Welcome <%= locals.accountData?.account_firstname %>
            </a>

            <!-- Logout link -->
            <a href="/account/logout" title="Click to log out"> | Logout</a>

        <% } else { %>
            <!-- Default login link when not logged in -->
            <a href="/account/login" title="Click to log in">My Account</a>
        <% } %>
    </div>
</header>
